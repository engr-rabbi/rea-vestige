# Vestige configuration (copy to .env and adjust; no real secrets belong here)

# --- Storage ---
# Root directory for registry, evidence store, cache and reports.
VESTIGE_DATA_DIR=
# Directory for derived/scratch files (reports, provider workspaces).
VESTIGE_WORK_DIR=

# --- Limits (Tier 1 defaults) ---
# Maximum bytes for a single input file read into analysis.
VESTIGE_MAX_INPUT_FILE_BYTES=52428800
# Maximum number of files scanned for directory/JavaScript targets.
VESTIGE_MAX_SCAN_FILES=2000
# Default external-tool timeout in milliseconds.
VESTIGE_TOOL_TIMEOUT_MS=120000
# Maximum bytes captured from an external tool's combined output.
VESTIGE_MAX_TOOL_OUTPUT_BYTES=4194304

# --- MCP server ---
# Log level for stderr diagnostics: trace|debug|info|warn|error|silent
VESTIGE_LOG_LEVEL=info
# HTTP transport (opt-in): bind port and host.
VESTIGE_HTTP_PORT=
VESTIGE_HTTP_HOST=127.0.0.1
# REQUIRED for non-loopback HTTP binds: bearer token clients must present.
VESTIGE_HTTP_TOKEN=
# Comma-separated extra allowed Origin values for browser-based clients.
VESTIGE_HTTP_ALLOWED_ORIGINS=

# --- Provider integrations ---
# Ghidra installation directory (contains support/analyzeHeadless).
GHIDRA_INSTALL_DIR=
